# Copie para .env.local (local) ou cadastre na Vercel em Settings > Environment Variables.
# NUNCA commite valores reais.
MP_ACCESS_TOKEN=TEST-seu-access-token-de-teste-aqui
SITE_URL=https://seu-site.vercel.app
# Mercado Pago > sua aplicação > Webhooks > Assinatura secreta
MP_WEBHOOK_SECRET=sua-assinatura-secreta-aqui
# Supabase > Project Settings > API (URL do projeto e a chave SECRETA, nunca a publishable)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_sua-chave-aqui
# Senha do painel /admin.html (mínimo 12 caracteres, longa e única)
ADMIN_PASSWORD=troque-por-uma-senha-longa
